# Copy to .env and fill in. .env is git-ignored.

# Required: OpenAI key used for the Decisions API, Notes and embeddings.
OPENAI_API_KEY=

# Optional: each review is traced in LangSmith when set, and only then.
# LANGSMITH_API_KEY=

# Optional overrides (defaults live in src/case_mgmt_ai_demo/config.py).
# PRA_DECISIONS_API_MODEL=gpt-6-luna
# PRA_NOTES_MODEL=gpt-6-luna
# PRA_SELECTOR_MODEL=gpt-6-luna
# PRA_SECTION_VALIDATOR_MODEL=gpt-6-luna
# PRA_EMBEDDING_MODEL=text-embedding-3-large
# Where review gets its Sections: index (built by ingest) or fixture (12 hand-typed chunks).
# PRA_RETRIEVER=index
# PRA_RETRIEVAL_TOP_K=8
# PRA_APPROVAL_CUTOFF=0.5
# PRA_BORDERLINE_LOW=0.4
# PRA_BORDERLINE_HIGH=0.6
# PRA_DATA_DIR=data
# PRA_REGLAMENTO_PDF=docs_to_use/RC-2023-E.pdf
# PRA_COBROS_PDF=docs_to_use/COBROS OA-2022-07.pdf
# Permit Requests `serve` stores the first time it runs.
# PRA_EXAMPLES_DIR=examples
# The demo cases and their cached Recommendations (seed, refresh, regress).
# PRA_DEMO_CASES_DIR=demo_cases
# regress reports a score that moved by more than this since the cached Recommendation.
# PRA_REGRESSION_DRIFT_THRESHOLD=0.15
# What reads text the PDF draws as outlines: tesseract or unlimited-ocr.
# PRA_OCR_ENGINE=tesseract
# PRA_TESSDATA_DIR=/usr/share/tessdata

# Set to 1 to run tests that call real models (costs money).
# RUN_REAL_MODEL_TESTS=1
